<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass button with a cyan glow line. Gold when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#99061418" />
            <stroke android:width="1dp" android:color="#4046F0FF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5546F0FF" />
            <stroke android:width="1.5dp" android:color="@color/hud_gold" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9061418" />
            <stroke android:width="1.5dp" android:color="@color/hud_cyan" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
