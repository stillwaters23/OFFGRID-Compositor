<?xml version="1.0" encoding="utf-8"?>
<!-- Black glass bar with a soft white line on top and a short brighter mark.
     The terminal panel repaints it in the theme colors. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F2000000"
                android:startColor="#D9000000" />
        </shape>
    </item>
    <item
        android:gravity="top|fill_horizontal"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#99FFFFFF" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="2dp"
        android:gravity="top|start"
        android:left="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_mark" />
        </shape>
    </item>
</layer-list>
