<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass bar with a cyan line on top and a short gold mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F2020508"
                android:startColor="#D9071419" />
        </shape>
    </item>
    <item
        android:gravity="top|fill_horizontal"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#9946F0FF" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="2dp"
        android:gravity="top|start"
        android:left="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_gold" />
        </shape>
    </item>
</layer-list>
