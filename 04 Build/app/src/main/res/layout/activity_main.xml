<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/camera_picture"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <View
        android:id="@+id/playback_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

    <TextureView
        android:id="@+id/playback_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/playback_picture"
        android:visibility="gone" />

    <!-- Phase 1.2 (V2 7.2): the record bar never shows. Its words go to the panel's status line
         and to Phone 2. Record and Play are rows in the Record folder. The views stay for the
         ids the code still binds, but they are GONE for good. -->
    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hud_bar"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:maxLines="3"
            android:text="@string/camera_starting"
            android:textColor="@color/hud_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/record_button"
                style="@style/HudButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/record_five"
                android:visibility="gone" />

            <Button
                android:id="@+id/play_button"
                style="@style/HudButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:text="@string/play_last"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/action_button"
            style="@style/HudButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/try_again"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playback_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hud_bar"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/playback_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:maxLines="3"
            android:text="@string/playback_hint"
            android:textColor="@color/hud_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/back_button"
            style="@style/HudButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/back_to_camera" />
    </LinearLayout>

    <!-- Step 2.2. The soft center cross shown while the panel is dragged. It never takes taps. -->
    <com.offgrid.compositor.terminal.SnapGuideView
        android:id="@+id/snap_guides"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Unlock strip sits at the bottom so Android 15's "Viewing full screen" hint cannot cover it. -->
    <LinearLayout
        android:id="@+id/unlock_strip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:elevation="12dp"
        android:background="@drawable/hud_bar"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/unlock_strip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="@string/terminal_locked_label"
            android:textColor="@color/hud_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/unlock_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/hud_button"
            android:contentDescription="@string/terminal_unlock"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/terminal_unlock"
            android:textColor="@color/hud_button_text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- The floating terminal panel. Royalty's private control, not painted into the video.
         Unlocked, it shows at once so the camera and diamond never flash before the folders. -->
    <com.offgrid.compositor.terminal.TerminalPanel
        android:id="@+id/terminal_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:visibility="visible" />

</FrameLayout>
